      "Bash(npm run dev:*)",
      "Bash(python:*)",
      "Bash(timeout:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(pip freeze)",
      "Bash(move:*)",
      "Bash(node:*)",
