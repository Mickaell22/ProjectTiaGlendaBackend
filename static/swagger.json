{
  "openapi": "3.0.0",
  "info": {
    "title": "API Centro Tía Glenda",
    "version": "1.0.0",
    "description": "Sistema de Gestión para Centro Terapéutico y Pedagógico\n\n## Funcionalidades\n- Gestión de usuarios y autenticación\n- Gestión de personas (personal, pacientes, alumnos)\n- Gestión de tutores y relaciones familiares\n- Gestión de pacientes y seguimiento terapéutico\n- Gestión de especialidades terapéuticas y pedagógicas\n- Gestión del personal del centro\n- Control de roles y permisos\n- Estadísticas y reportes\n\n## Autenticación\nPara usar endpoints protegidos:\n1. Hacer login en `/api/login`\n2. Usar el token en Authorization: `Bearer <token>`",
    "contact": {
      "name": "Sistema Tía Glenda",
      "email": "admin@centro-tia-glenda.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor de desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Token obtenido del endpoint /api/login"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["usuario", "contrasenia"],
        "properties": {
          "usuario": {
            "type": "string",
            "example": "admin",
            "description": "Nombre de usuario"
          },
          "contrasenia": {
            "type": "string",
            "example": "admin123",
            "description": "Contraseña del usuario"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "example": "success"},
          "message": {"type": "string", "example": "Autenticacion exitosa"},
          "data": {
            "type": "object",
            "properties": {
              "token": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."},
              "user": {
                "type": "object",
                "properties": {
                  "id": {"type": "integer", "example": 1},
                  "usuario": {"type": "string", "example": "admin"},
                  "nombre_completo": {"type": "string", "example": "Admin Sistema"},
                  "rol": {"type": "string", "example": "Administrador"},
                  "correo": {"type": "string", "example": "admin@centro.com"}
                }
              }
            }
          }
        }
      },
      "PersonaRequest": {
        "type": "object",
        "required": ["nombre", "apellido", "cedula"],
        "properties": {
          "nombre": {"type": "string", "example": "María Elena"},
          "apellido": {"type": "string", "example": "García"},
          "cedula": {"type": "string", "example": "12345678"},
          "telefono": {"type": "string", "example": "+50612345678"},
          "correo": {"type": "string", "example": "maria@email.com"},
          "direccion": {"type": "string", "example": "San José, Costa Rica"},
          "fecha_nacimiento": {"type": "string", "format": "date", "example": "1990-05-15"},
          "estado": {"type": "string", "enum": ["activo", "inactivo"], "example": "activo"}
        }
      },
      "TutorRequest": {
        "type": "object",
        "required": ["persona_id", "parentesco"],
        "properties": {
          "persona_id": {"type": "integer", "example": 1},
          "parentesco": {"type": "string", "enum": ["madre", "padre", "abuelo", "abuela", "hermano", "hermana", "tio", "tia", "otro"], "example": "madre"},
          "es_contacto_emergencia": {"type": "boolean", "example": true},
          "observaciones_tutor": {"type": "string", "example": "Madre muy colaborativa, disponible para citas matutinas"}
        }
      },
      "PacienteRequest": {
        "type": "object",
        "required": ["persona_id", "tutor_id"],
        "properties": {
          "persona_id": {"type": "integer", "example": 1},
          "tutor_id": {"type": "integer", "example": 1},
          "fecha_ingreso": {"type": "string", "format": "date", "example": "2023-01-15"},
          "observaciones": {"type": "string", "example": "Paciente con necesidades de terapia ocupacional"}
        }
      },
      "EstadoPacienteRequest": {
        "type": "object",
        "required": ["estado"],
        "properties": {
          "estado": {"type": "string", "enum": ["activo", "inactivo", "alta", "derivado"], "example": "activo"}
        }
      },
      "EspecialidadRequest": {
        "type": "object",
        "required": ["nombre", "area"],
        "properties": {
          "nombre": {"type": "string", "example": "Terapia Ocupacional Pediátrica"},
          "area": {"type": "string", "enum": ["terapeutico", "pedagogico"], "example": "terapeutico"},
          "estado": {"type": "string", "enum": ["activo", "inactivo"], "example": "activo"}
        }
      },
      "PersonalRequest": {
        "type": "object",
        "required": ["persona_id"],
        "properties": {
          "persona_id": {"type": "integer", "example": 1},
          "titulo_profesional": {"type": "string", "example": "Licenciatura en Terapia Ocupacional"},
          "estado": {"type": "string", "enum": ["activo", "inactivo"], "example": "activo"}
        }
      },
      "AsignarEspecialidadRequest": {
        "type": "object",
        "required": ["especialidad_id"],
        "properties": {
          "especialidad_id": {"type": "integer", "example": 1}
        }
      },
      "UsuarioRequest": {
        "type": "object",
        "required": ["usuario", "contrasenia", "persona_id", "rol_id"],
        "properties": {
          "usuario": {"type": "string", "example": "maria.garcia"},
          "contrasenia": {"type": "string", "example": "Password123!", "minLength": 8},
          "persona_id": {"type": "integer", "example": 2},
          "rol_id": {"type": "integer", "example": 2},
          "estado": {"type": "string", "enum": ["activo", "inactivo", "bloqueado"], "example": "activo"}
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "example": "success"},
          "message": {"type": "string", "example": "Operacion exitosa"},
          "data": {"type": "object"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "example": "error"},
          "message": {"type": "string", "example": "Error en la operacion"},
          "code": {"type": "integer", "example": 400}
        }
      }
    }
  },
