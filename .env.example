# Variables de entorno para Railway - RENOMBRAR A .env PARA DESARROLLO LOCAL
# NO SUBIR .env AL REPOSITORIO

# Base de datos (Railway proveerá estas automáticamente en producción)
DATABASE_URL=postgresql://user:password@host:port/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=centro_tia_glenda
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# JWT Secret (CAMBIAR en producción)
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion

# Configuración de entorno
AMBIENTE=PRODUCTION
DEBUG=False
PORT=5000

# Configuración de logs (opcional)
LOG_LEVEL=INFO

# CORS Origins para producción (agregar tu dominio frontend)
# Para Railway, incluir el dominio de tu frontend desplegado
CORS_ORIGINS=https://projecttiaglendadebug-k.up.railway.app,https://tu-dominio-personalizado.com

# Variables específicas de Railway (Railway las establecerá automáticamente)
RAILWAY_ENVIRONMENT=production
RAILWAY_STATIC_URL=tu-backend.up.railway.app

# API Base URL para el backend
API_BASE_URL=https://tu-backend.up.railway.app